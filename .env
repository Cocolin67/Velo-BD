# Copier ce fichier en .env puis adapter les valeurs. Ne jamais committer .env.

# prod : erreurs masquées et cache Twig activé ; dev : erreurs détaillées
APP_ENV=dev
APP_DEBUG=true

# Compte MySQL dédié créé par database/app_user.sql (jamais root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velo_libre_service
DB_USER=velo_app
DB_PASS="MotDePasse!"
