{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% block title %}{{ station.nom }}{% endblock %}

{% block content %}
  <a href="{{ url_for('stations') }}" class="text-sm text-zinc-500 hover:text-zinc-900">← Toutes les stations</a>

  <div class="mb-6 mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">{{ station.nom }}</h1>
        {{ ui.badge(station.etat_station) }}
      </div>
      <p class="mt-1 text-sm text-zinc-500">
        {{ station.adresse }} ·
        <a class="link" target="_blank" rel="noopener noreferrer"
           href="https://www.openstreetmap.org/?mlat={{ station.latitude }}&mlon={{ station.longitude }}#map=17/{{ station.latitude }}/{{ station.longitude }}">Voir sur la carte ↗</a>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="{{ url_for('reports', {}, {station: station.id_station}) }}" class="btn-ghost">Signaler un problème</a>
      {% if is_granted('administrateur') %}
        <a href="{{ url_for('stations.edit', {id: station.id_station}) }}" class="btn-secondary">Modifier</a>
        <form method="post" action="{{ url_for('stations.delete', {id: station.id_station}) }}"
              onsubmit="return confirm('Supprimer définitivement cette station et ses bornes ?')">
          {{ csrf_field() }}
          <button class="btn-danger">Supprimer</button>
        </form>
      {% endif %}
    </div>
  </div>

  <section class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{ ui.stat('Vélos mécaniques disponibles', station.nb_velos_mecaniques) }}
    {{ ui.stat('Vélos électriques disponibles', station.nb_velos_electriques) }}
    {{ ui.stat('Bornes libres', station.nb_bornes_libres, 'sur ' ~ station.nb_bornes ~ ' bornes') }}
    {{ ui.stat('Remplissage', station.taux_remplissage|pct, station.nb_velos ~ ' vélo(s) sur les bornes') }}
  </section>

  <h2 class="mb-3 font-semibold">Bornes</h2>
  {% if bornes is empty %}
    <div class="card">{{ ui.empty('Aucune borne dans cette station.') }}</div>
  {% else %}
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {% for b in bornes %}
        <div class="card flex flex-col gap-2 p-4 {{ b.etat_borne == 'hors_service' ? 'opacity-60' }}">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold">Borne {{ b.num_borne }}</span>
            {% if b.etat_borne != 'fonctionnelle' %}{{ ui.badge(b.etat_borne) }}{% endif %}
          </div>

          {% if b.id_velo %}
            <div class="flex items-center justify-between text-sm">
              <span>
                Vélo #{{ b.id_velo }}
                <span class="text-zinc-500">· {{ b.type_velo|label }}</span>
              </span>
              {{ ui.badge(b.etat_velo) }}
            </div>
            {% if b.niveau_batterie is not null %}
              <div class="flex items-center gap-2 text-xs text-zinc-500">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-zinc-100">
                  <div class="h-full rounded-full {{ b.niveau_batterie < 20 ? 'bg-red-500' : 'bg-sky-500' }}" style="width: {{ b.niveau_batterie }}%"></div>
                </div>
                {{ b.niveau_batterie }} %
              </div>
            {% endif %}
            {% include 'stations/_borne_actions.twig' %}
          {% else %}
            <p class="text-sm text-zinc-400">Libre</p>
          {% endif %}

          {% if is_granted('administrateur') %}
            <form method="post" action="{{ url_for('stations.borne', {id: station.id_station, borne: b.id_borne}) }}" class="mt-auto">
              {{ csrf_field() }}
              <input type="hidden" name="etat_borne" value="{{ b.etat_borne == 'fonctionnelle' ? 'hors_service' : 'fonctionnelle' }}">
              <button class="text-xs text-zinc-500 hover:text-zinc-900">
                {{ b.etat_borne == 'fonctionnelle' ? 'Mettre hors service' : 'Remettre en service' }}
              </button>
            </form>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
