{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% block title %}Stations{% endblock %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Stations</h1>
      <p class="mt-1 text-sm text-zinc-500">Disponibilités en temps réel des vélos et des bornes.</p>
    </div>
    {% if is_granted('administrateur') %}
      <a href="{{ url_for('stations.create') }}" class="btn-primary">+ Nouvelle station</a>
    {% endif %}
  </div>

  <form method="get" class="card mb-4 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto]">
    {{ ui.sort_fields(tri, 'stations') }}
    <input type="search" name="q" value="{{ filters.q }}" placeholder="Rechercher un nom ou une adresse…" class="input" aria-label="Recherche">
    <select name="etat" class="input" aria-label="État">
      <option value="">Tous les états</option>
      {% for e in etats %}<option value="{{ e }}" {{ filters.etat == e ? 'selected' }}>{{ e|label }}</option>{% endfor %}
    </select>
    <select name="dispo" class="input" aria-label="Disponibilité">
      <option value="">Toutes</option>
      <option value="velos" {{ filters.dispo == 'velos' ? 'selected' }}>Avec vélos disponibles</option>
      <option value="electriques" {{ filters.dispo == 'electriques' ? 'selected' }}>Avec vélos électriques</option>
      <option value="bornes" {{ filters.dispo == 'bornes' ? 'selected' }}>Avec bornes libres</option>
    </select>
    <div class="flex gap-2">
      <button class="btn-primary">Filtrer</button>
      {% if query|filter((v, k) => k not in ['tri', 'ordre']) %}<a href="{{ url_for('stations') }}" class="btn-ghost">Effacer</a>{% endif %}
    </div>
  </form>

  <div class="card overflow-hidden" data-zone="stations">
    {% if stations is empty %}
      {{ ui.empty('Aucune station ne correspond à ces critères.') }}
    {% else %}
      <div class="overflow-x-auto">
        <table class="table">
          <thead id="stations-head" class="bg-zinc-50">
            <tr>
              {{ ui.th('Station', 'nom', tri) }}{{ ui.th('État', 'etat', tri) }}
              {{ ui.th('Mécaniques', 'mecaniques', tri, 'text-right') }}{{ ui.th('Électriques', 'electriques', tri, 'text-right') }}
              {{ ui.th('Bornes libres', 'libres', tri, 'text-right') }}{{ ui.th('Remplissage', 'remplissage', tri) }}
            </tr>
          </thead>
          <tbody id="stations-body" class="divide-y divide-zinc-100">
            {% for s in stations %}
              <tr>
                <td>
                  <a href="{{ url_for('stations.show', {id: s.id_station}) }}" class="font-medium text-zinc-900 hover:text-emerald-700">{{ s.nom }}</a>
                  <p class="max-w-xs truncate text-xs text-zinc-500">{{ s.adresse }}</p>
                </td>
                <td>{{ ui.badge(s.etat_station) }}</td>
                <td class="text-right tabular-nums">{{ s.nb_velos_mecaniques }}</td>
                <td class="text-right tabular-nums">{{ s.nb_velos_electriques }}</td>
                <td class="text-right tabular-nums">{{ s.nb_bornes_libres }} <span class="text-zinc-400">/ {{ s.nb_bornes }}</span></td>
                <td>{{ ui.meter(s.taux_remplissage) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div id="stations-pager" data-zone-pager>{{ ui.pagination('stations', page, has_next, query) }}</div>
    {% endif %}
  </div>
{% endblock %}
