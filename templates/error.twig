{% extends 'layout.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
  <div class="card mx-auto max-w-lg px-6 py-12 text-center">
    <p class="text-sm font-semibold text-emerald-700">Erreur {{ status }}</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">{{ title }}</h1>
    <p class="mt-2 text-sm text-zinc-500">
      {{ status == 500 ? 'Une erreur inattendue est survenue. Réessayez dans un instant.' : message }}
    </p>
    <a href="{{ url_for('home') }}" class="btn-primary mt-6">Retour à l'accueil</a>
  </div>

  {% if details %}
    <pre class="mx-auto mt-6 max-w-4xl overflow-x-auto rounded-xl bg-zinc-900 p-4 text-xs text-zinc-100">{{ details }}</pre>
  {% endif %}
{% endblock %}
