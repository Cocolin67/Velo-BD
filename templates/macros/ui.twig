{# ---------------------------------------------------------------------------
   Composants d'interface réutilisables
   --------------------------------------------------------------------------- #}

{# Lien de navigation, actif si l'URL courante est la route (ou une sous-page) :
   texte en couleur, en gras et souligné. #}
{% macro nav_link(route, label) %}
  {% set url = url_for(route) %}
  {# current_url() de Slim ajoute le chemin de base devant le chemin de la requête, qui le contient
     déjà sous Apache dans un sous-dossier (WAMP/XAMPP) : on retire ce préfixe en trop. #}
  {% set path = current_url()|slice(base_path()|length) %}
  {% set active = route == 'home' ? path == url : (path == url or path starts with url ~ '/') %}
  <a href="{{ url }}"
     class="rounded-lg px-3 py-1.5 text-sm transition {{ active
       ? 'font-semibold text-emerald-700 underline decoration-emerald-600 decoration-2 underline-offset-[6px]'
       : 'font-medium text-zinc-500 hover:bg-zinc-50 hover:text-zinc-900' }}"
     {% if active %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{# Pastille colorée pour une valeur ENUM (voir les filtres label et tone) #}
{% macro badge(value, text = null) %}
  {% set tones = {
    green: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
    blue:  'bg-sky-50 text-sky-700 ring-sky-600/20',
    amber: 'bg-amber-50 text-amber-800 ring-amber-600/20',
    red:   'bg-red-50 text-red-700 ring-red-600/20',
    zinc:  'bg-zinc-100 text-zinc-600 ring-zinc-500/20'
  } %}
  <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset {{ tones[value|tone] }}">{{ text ?? value|label }}</span>
{% endmacro %}

{# Carte d'indicateur #}
{% macro stat(label, value, hint = null) %}
  <div class="card p-5">
    <p class="text-sm text-zinc-500">{{ label }}</p>
    <p class="mt-1 text-2xl font-semibold tracking-tight">{{ value }}</p>
    {% if hint %}<p class="mt-1 text-xs text-zinc-400">{{ hint }}</p>{% endif %}
  </div>
{% endmacro %}

{# En-tête de page : titre, sous-titre et zone d'actions (bloc HTML déjà échappé) #}
{% macro page_header(title, subtitle = null) %}
  <div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">{{ title }}</h1>
    {% if subtitle %}<p class="mt-1 text-sm text-zinc-500">{{ subtitle }}</p>{% endif %}
  </div>
{% endmacro %}

{# État vide #}
{% macro empty(message) %}
  <div class="px-6 py-12 text-center text-sm text-zinc-500">{{ message }}</div>
{% endmacro %}

{# En-tête de colonne triable (tri côté serveur, voir App\Support\Sort::view).
   Clic sur le libellé : croissant, puis alterne croissant / décroissant.
   Flèche vers le bas = croissant (affichée au survol tant qu'aucun tri n'est actif),
   flèche vers le haut = décroissant ; la croix revient à l'ordre par défaut.
   Le même rendu est produit en JavaScript pour les tableaux triés dans le navigateur
   (attribut data-sortable, voir layout.twig). #}
{% macro th(label, key, tri, class = '') %}
  {% set active = tri.key == key %}
  {% set next = active and tri.dir == 'asc' ? 'desc' : 'asc' %}
  {% set anchor = tri.anchor ? '#' ~ tri.anchor : '' %}
  <th class="{{ class }}" aria-sort="{{ active ? (tri.dir == 'asc' ? 'ascending' : 'descending') : 'none' }}">
    <span class="sort-head">
      <a class="sort-btn" href="{{ url_for(tri.route, tri.args, tri.query|merge({('tri' ~ tri.suffix): key, ('ordre' ~ tri.suffix): next})) ~ anchor }}"
         title="Trier par ordre {{ next == 'asc' ? 'croissant' : 'décroissant' }}">
        <span>{{ label }}</span>
        <svg class="sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {% if active and tri.dir == 'desc' %}<path d="M12 19V5M5 12l7-7 7 7"/>{% else %}<path d="M12 5v14M19 12l-7 7-7-7"/>{% endif %}
        </svg>
      </a>
      {% if active %}
        <a class="sort-reset" href="{{ url_for(tri.route, tri.args, tri.query) ~ anchor }}" title="Réinitialiser le tri" aria-label="Réinitialiser le tri">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </a>
      {% endif %}
    </span>
  </th>
{% endmacro %}

{# Champs cachés : un formulaire de filtres conserve le tri choisi dans l'en-tête.
   zone = data-zone du tableau : l'enveloppe est remplacée avec lui quand on trie sans
   recharger la page (voir layout.twig). #}
{% macro sort_fields(tri, zone) %}
  <span id="{{ zone }}-fields" hidden>
    {% if tri.key %}
      <input type="hidden" name="tri{{ tri.suffix }}" value="{{ tri.key }}">
      <input type="hidden" name="ordre{{ tri.suffix }}" value="{{ tri.dir }}">
    {% endif %}
  </span>
{% endmacro %}

{# Pagination précédent / suivant (pas de COUNT(*) coûteux sur les grosses tables) #}
{% macro pagination(route, page, has_next, query = {}, args = {}) %}
  {% if page > 1 or has_next %}
    <div class="flex items-center justify-between border-t border-zinc-200 px-4 py-3 text-sm">
      <span class="text-zinc-500">Page {{ page }}</span>
      <div class="flex gap-2">
        {% if page > 1 %}
          <a class="btn-secondary" href="{{ url_for(route, args, query|merge({page: page - 1})) }}">← Précédent</a>
        {% endif %}
        {% if has_next %}
          <a class="btn-secondary" href="{{ url_for(route, args, query|merge({page: page + 1})) }}">Suivant →</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endmacro %}

{# Pagination d'un tableau parmi plusieurs sur la même page : chaque tableau a son
   propre paramètre ($param) ; anchor ramène l'utilisateur au tableau concerné.
   p = résultat de StatsController::paginate (rows, page, has_next, total, from, to) #}
{% macro pager(route, p, query, param, anchor = null) %}
  {% if p.total > 0 %}
    <div class="flex items-center justify-between border-t border-zinc-200 px-4 py-2.5 text-xs">
      <span class="text-zinc-500 tabular-nums">{{ p.from }}–{{ p.to }} sur {{ p.total }}</span>
      {% if p.page > 1 or p.has_next %}
        <div class="flex gap-2">
          {% if p.page > 1 %}
            <a class="btn-secondary" href="{{ url_for(route, {}, query|merge({(param): p.page - 1})) }}{{ anchor ? '#' ~ anchor }}">← Préc.</a>
          {% endif %}
          {% if p.has_next %}
            <a class="btn-secondary" href="{{ url_for(route, {}, query|merge({(param): p.page + 1})) }}{{ anchor ? '#' ~ anchor }}">Suiv. →</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

{# Barre de progression (taux entre 0 et 1) #}
{% macro meter(ratio) %}
  {% set p = ((ratio ?? 0) * 100)|round %}
  {% set color = p >= 85 ? 'bg-red-500' : (p <= 15 ? 'bg-amber-500' : 'bg-emerald-500') %}
  <div class="flex items-center gap-2">
    <div class="h-1.5 w-20 overflow-hidden rounded-full bg-zinc-100">
      <div class="h-full rounded-full {{ color }}" style="width: {{ min(p, 100) }}%"></div>
    </div>
    <span class="text-xs tabular-nums text-zinc-500">{{ p }} %</span>
  </div>
{% endmacro %}

{# Champ de formulaire avec libellé et message d'erreur #}
{% macro field(name, label, value = null, error = null, type = 'text', attrs = {}) %}
  <div>
    <label for="f-{{ name }}" class="label">{{ label }}</label>
    <input id="f-{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ value }}"
           class="input {{ error ? 'border-red-400 focus:border-red-500 focus:ring-red-500/20' }}"
           {% for k, v in attrs %}{{ k }}{% if v is not same as(true) %}="{{ v }}"{% endif %} {% endfor %}
           {% if error %}aria-invalid="true" aria-describedby="e-{{ name }}"{% endif %}>
    {% if error %}<p id="e-{{ name }}" class="mt-1 text-xs text-red-600">{{ error }}</p>{% endif %}
  </div>
{% endmacro %}
