{% import 'macros/ui.twig' as ui %}
<!doctype html>
<html lang="fr" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Accueil{% endblock %} · {{ app_name }}</title>
  <link rel="icon" href="{{ base_path() }}/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.1.11"></script>
  <style type="text/tailwindcss">
    @theme {
      --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
    }
    /* Tailwind v4 : une classe réutilisée par @apply doit être déclarée avec @utility */
    @utility btn { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40 disabled:opacity-50; }
    @utility btn-primary   { @apply btn bg-emerald-600 text-white hover:bg-emerald-700; }
    @utility btn-secondary { @apply btn border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-50; }
    @utility btn-danger    { @apply btn border border-red-200 bg-white text-red-600 hover:bg-red-50; }
    @utility btn-ghost     { @apply btn text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900; }
    @layer components {
      .card     { @apply rounded-2xl border border-zinc-200 bg-white shadow-sm; }
      .label    { @apply mb-1.5 block text-sm font-medium text-zinc-700; }
      .input    { @apply block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 shadow-xs placeholder:text-zinc-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20; }
      .table    { @apply min-w-full divide-y divide-zinc-200 text-sm; }
      .table th { @apply px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500; }
      .table td { @apply whitespace-nowrap px-4 py-3 text-zinc-700; }
      .table tbody tr { @apply hover:bg-zinc-50/70; }
      .link     { @apply font-medium text-emerald-700 hover:text-emerald-800 hover:underline; }

      /* En-têtes triables (macro ui.th et tableaux data-sortable) */
      .sort-head  { @apply inline-flex items-center gap-1 align-middle; }
      .sort-btn   { @apply inline-flex cursor-pointer items-center gap-1 rounded hover:text-zinc-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40; font: inherit; letter-spacing: inherit; text-transform: inherit; }
      .sort-icon  { @apply size-3.5 shrink-0 opacity-0 transition-opacity; }
      .sort-btn:hover .sort-icon, .sort-btn:focus-visible .sort-icon { @apply opacity-100; }
      th[aria-sort="ascending"], th[aria-sort="descending"] { @apply text-zinc-900; }
      th[aria-sort="ascending"] .sort-icon, th[aria-sort="descending"] .sort-icon { @apply text-emerald-600 opacity-100; }
      .sort-reset { @apply grid size-4 shrink-0 cursor-pointer place-items-center rounded text-zinc-400 hover:bg-zinc-200 hover:text-zinc-700; }
      .sort-reset svg { @apply size-3; }
      /* Colonnes alignées à droite : flèche et croix à gauche du libellé, qui reste au-dessus des chiffres */
      th.text-right .sort-head, th.text-right .sort-btn { @apply flex-row-reverse; }
    }
  </style>
  <style>
    /* Transitions Swup : le contenu glisse de gauche à droite. L'ancienne page sort vers la
       droite (is-leaving), la nouvelle entre par la gauche (is-rendering) puis revient en place. */
    html.is-changing .transition-slide { transition: opacity .22s ease, transform .22s ease; }
    html.is-animating.is-leaving .transition-slide { opacity: 0; transform: translateX(3rem); }
    html.is-animating.is-rendering .transition-slide { opacity: 0; transform: translateX(-3rem); }
    body { overflow-x: clip; }   /* pas de barre de défilement horizontale pendant le glissement */
    @media (prefers-reduced-motion: reduce) {
      html.is-animating.is-leaving .transition-slide,
      html.is-animating.is-rendering .transition-slide { transform: none; }
    }
  </style>
  {% block head %}{% endblock %}
</head>
<body class="min-h-full bg-zinc-50 font-sans text-zinc-900 antialiased">
  <header class="sticky top-0 z-30 border-b border-zinc-200 bg-white/85 backdrop-blur">
    <div id="swup-header" class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4">
      <a href="{{ url_for('home') }}" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="grid size-8 place-items-center rounded-lg bg-emerald-600 text-white">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm-3 11.5V14l-3-3 4-3 2 3h2"/></svg>
        </span>
        <span class="hidden sm:inline">{{ app_name }}</span>
      </a>

      <nav class="hidden flex-1 items-center gap-1 md:flex">
        {% block nav %}{% include 'partials/nav.twig' %}{% endblock %}
      </nav>

      <div class="ml-auto flex items-center gap-2">
        {% include 'partials/account.twig' %}
        <details class="relative md:hidden">
          <summary class="btn-ghost cursor-pointer list-none" aria-label="Menu">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </summary>
          <nav class="card absolute right-0 mt-2 flex w-56 flex-col gap-1 p-2">
            {% include 'partials/nav.twig' %}
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="swup" class="transition-slide mx-auto max-w-6xl px-4 py-8">
    {% for flash in flashes() %}
      {% set styles = {
        success: 'border-emerald-200 bg-emerald-50 text-emerald-800',
        error:   'border-red-200 bg-red-50 text-red-800',
        info:    'border-sky-200 bg-sky-50 text-sky-800'
      } %}
      <div class="mb-4 rounded-xl border px-4 py-3 text-sm {{ styles[flash.type] }}" role="{{ flash.type == 'error' ? 'alert' : 'status' }}">
        {{ flash.message }}
      </div>
    {% endfor %}

    {% block content %}{% endblock %}
  </main>

  <footer class="mx-auto max-w-6xl px-4 pb-10 pt-4 text-xs text-zinc-400">
    {{ app_name }} · Projet BD70 · UTBM
  </footer>

  {% block scripts %}{% endblock %}

  {# Tri dans le navigateur des tableaux non paginés (<table data-sortable>), avec le même
     comportement que la macro ui.th des tableaux triés par le serveur. Valeur d'une cellule :
     son attribut data-sort-value s'il existe, sinon son texte ; « — » et vide en fin de liste. #}
  <script>
    (() => {
      const ICON_DOWN = '<path d="M12 5v14M19 12l-7 7-7-7"/>';
      const ICON_UP   = '<path d="M12 19V5M5 12l7-7 7 7"/>';
      const svg = (paths, cls, width) =>
        `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

      const valueOf = (cell) => {
        const raw = (cell?.dataset.sortValue ?? cell?.textContent ?? '').trim();
        if (raw === '' || raw === '—') return null;
        const num = raw.replace(/[\s  ]/g, '').replace(/^#/, '').replace(/(€|%|km|min)$/, '').replace(',', '.');
        return /^-?\d+(\.\d+)?$/.test(num) ? Number(num) : raw;
      };
      const compare = (a, b) => {
        if (a === null || b === null) return (a === null) - (b === null);   // vides toujours en dernier
        if (typeof a === 'number' && typeof b === 'number') return a - b;
        return String(a).localeCompare(String(b), 'fr', { numeric: true, sensitivity: 'base' });
      };

      function render(table) {
        const { col, dir } = table._sort;
        table.querySelectorAll('thead th').forEach((th, i) => {
          if (!th._label) return;
          const active = i === col;
          th.setAttribute('aria-sort', active ? (dir === 'asc' ? 'ascending' : 'descending') : 'none');
          const next = active && dir === 'asc' ? 'décroissant' : 'croissant';
          th.innerHTML = `<span class="sort-head"><button type="button" class="sort-btn" title="Trier par ordre ${next}"><span></span>${svg(active && dir === 'desc' ? ICON_UP : ICON_DOWN, 'sort-icon', 2.25)}</button>`
            + (active ? `<button type="button" class="sort-reset" title="Réinitialiser le tri" aria-label="Réinitialiser le tri">${svg('<path d="M18 6 6 18M6 6l12 12"/>', '', 2.5)}</button>` : '')
            + '</span>';
          th.querySelector('.sort-btn span').textContent = th._label;
          th.querySelector('.sort-btn').addEventListener('click', () => sortBy(table, i));
          th.querySelector('.sort-reset')?.addEventListener('click', () => sortBy(table, null));
        });
      }

      function sortBy(table, col) {
        const state = table._sort;
        state.dir = col !== null && col === state.col && state.dir === 'asc' ? 'desc' : 'asc';
        state.col = col;
        const body = table.tBodies[0];
        const rows = [...body.rows];
        rows.sort(col === null
          ? (a, b) => a._index - b._index                                   // ordre d'origine
          : (a, b) => (state.dir === 'asc' ? 1 : -1) * compare(valueOf(a.cells[col]), valueOf(b.cells[col]))
                      || a._index - b._index);
        body.append(...rows);
        render(table);
      }

      window.initSortableTables = () => {
        document.querySelectorAll('table[data-sortable]').forEach((table) => {
          if (table._sort || !table.tHead || !table.tBodies[0]) return;
          table._sort = { col: null, dir: 'asc' };
          [...table.tBodies[0].rows].forEach((row, i) => { row._index = i; });
          table.querySelectorAll('thead th').forEach((th) => {
            if (!th.hasAttribute('data-nosort') && th.textContent.trim() !== '') th._label = th.textContent.trim();
          });
          render(table);
        });
      };
      window.initSortableTables();
    })();
  </script>

  {# Swup : navigation sans rechargement complet entre les pages (les formulaires restent classiques).
     La page Statistiques et les exports CSV sont chargés normalement, car leurs scripts (Chart.js)
     ne seraient pas réexécutés par Swup. Pas de cache : les données changent après chaque action.

     Tri et pagination d'un tableau (liens .sort-btn, .sort-reset, et ceux de [data-zone-pager]
     dans un [data-zone="z"]) : seuls #z-head, #z-body, #z-pager et #z-fields sont remplacés,
     sans animation ni retour en haut de page. Le reste de la page (graphiques compris) ne bouge pas,
     ce qui permet aussi de trier les tableaux de la page Statistiques avec Swup. #}
  <script src="https://cdn.jsdelivr.net/npm/swup@4.10.0/dist/Swup.umd.js"></script>
  <script>
    (() => {
      if (typeof Swup === 'undefined') return;
      const statsPath = {{ url_for('stats')|json_encode|raw }};

      // Parties d'un tableau à remplacer quand le lien cliqué trie ou pagine ce tableau, sinon null
      const zoneParts = (el) => {
        const zone = el?.closest('[data-zone]');
        if (!zone || !el.closest('.sort-btn, .sort-reset, [data-zone-pager] a')) return null;
        const parts = ['head', 'body', 'pager', 'fields'].map((p) => `#${zone.dataset.zone}-${p}`);
        return parts.filter((sel) => document.querySelector(sel));
      };

      const swup = new Swup({
        containers: ['#swup-header', '#swup'],
        cache: false,
        ignoreVisit: (url, { el } = {}) => {
          const path = new URL(url, location.href).pathname;
          if (path.endsWith('.csv')) return true;
          if (zoneParts(el)) return false;
          return path === statsPath || path.startsWith(statsPath + '/');
        },
      });

      swup.hooks.on('visit:start', (visit) => {
        const parts = zoneParts(visit.trigger.el);
        if (!parts) return;
        visit.containers       = parts;
        visit.animation.animate = false;
        visit.scroll.reset     = false;
        visit.scroll.target    = false;   // ignore l'ancre (#od...) des liens de pagination
      });

      // Le contenu remplacé par Swup n'exécute pas de script : on réactive les tableaux triables
      swup.hooks.on('page:view', () => window.initSortableTables?.());
    })();
  </script>
</body>
</html>
