{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% block title %}Statistiques{% endblock %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Statistiques</h1>
      <p class="mt-1 text-sm text-zinc-500">Du {{ period.du|d }} au {{ period.au|d }} inclus.</p>
    </div>
    <form method="get" class="flex flex-wrap items-end gap-2">
      <label class="text-xs text-zinc-500">Du<input type="date" name="du" value="{{ period.du }}" class="input mt-1"></label>
      <label class="text-xs text-zinc-500">Au<input type="date" name="au" value="{{ period.au }}" class="input mt-1"></label>
      <label class="text-xs text-zinc-500">Par
        <select name="granularite" class="input mt-1">
          {% for g in ['jour', 'semaine', 'mois'] %}<option value="{{ g }}" {{ period.granularite == g ? 'selected' }}>{{ g|capitalize }}</option>{% endfor %}
        </select>
      </label>
      <button class="btn-primary">Appliquer</button>
    </form>
  </div>

  {# ---- Indicateurs clés #}
  <section class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{ ui.stat('Trajets terminés', kpi.trajets|num) }}
    {{ ui.stat('Durée moyenne', kpi.duree is null ? '—' : kpi.duree|round|duration) }}
    {{ ui.stat('Recettes des trajets', kpi.recettes|money, 'hors abonnements') }}
    {{ ui.stat('Heure de pointe', kpi.pointe is null ? '—' : kpi.pointe ~ ' h – ' ~ (kpi.pointe + 1) ~ ' h') }}
  </section>

  {# ---- Graphiques #}
  <section class="mb-6 grid gap-6 lg:grid-cols-2">
    <div class="card p-5 lg:col-span-2">
      {{ _self.card_title('Trajets par ' ~ period.granularite, 'trajets', query) }}
      <div class="h-64"><canvas id="chart-periods" aria-label="Trajets par période" role="img"></canvas></div>
    </div>
    <div class="card p-5">
      {{ _self.card_title('Heures de pointe (départs par heure)', 'heures', query) }}
      <div class="h-56"><canvas id="chart-hours" aria-label="Départs par heure" role="img"></canvas></div>
    </div>
    <div class="card p-5">
      {{ _self.card_title('Taux de remplissage moyen par heure', 'remplissage', query) }}
      <div class="h-56"><canvas id="chart-occupancy" aria-label="Remplissage par heure" role="img"></canvas></div>
    </div>
  </section>

  <section class="mb-6 grid gap-6 lg:grid-cols-3">
    {# ---- Indisponibilité #}
    <div class="card p-5">
      {{ _self.card_title('Indisponibilité de la flotte', 'indisponibilite', query) }}
      <p class="mb-4 text-xs text-zinc-500">Part du temps passée en atelier ou défectueux.</p>
      {% for type in ['tous', 'mecanique', 'electrique'] %}
        {% set f = fleet[type] ?? null %}
        <div class="flex items-center justify-between border-t border-zinc-100 py-2.5 text-sm first-of-type:border-0">
          <span>{{ type == 'tous' ? 'Toute la flotte' : type|label }} <span class="text-xs text-zinc-400">{{ f ? f.nb_velos ~ ' vélos' }}</span></span>
          <span class="font-semibold tabular-nums">{{ f ? f.taux_indisponibilite_pct|num(2) ~ ' %' : '—' }}</span>
        </div>
      {% endfor %}
    </div>

    {# ---- Recettes par formule #}
    <div class="card p-5 lg:col-span-2">
      {{ _self.card_title('Recettes par formule (factures émises)', 'recettes', query) }}
      {% set max = max(revenue|map(r => r.recettes_encaissees + r.en_attente)|merge([1])) %}
      <div class="space-y-3">
        {% for r in revenue %}
          <div>
            <div class="mb-1 flex justify-between text-sm">
              <span>{{ r.libelle }} <span class="text-xs text-zinc-400">{{ r.nb_factures }} factures</span></span>
              <span class="tabular-nums"><strong>{{ r.recettes_encaissees|money }}</strong>
                {% if r.en_attente > 0 %}<span class="text-xs text-amber-700">+ {{ r.en_attente|money }} en attente</span>{% endif %}</span>
            </div>
            <div class="flex h-2 overflow-hidden rounded-full bg-zinc-100">
              <div class="bg-emerald-500" style="width: {{ (r.recettes_encaissees / max * 100)|round(1) }}%"></div>
              <div class="bg-amber-300" style="width: {{ (r.en_attente / max * 100)|round(1) }}%"></div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="mb-6 grid gap-6 lg:grid-cols-3">
    {# ---- Origine-destination #}
    <div class="card overflow-hidden lg:col-span-2">
      <div class="px-5 pt-5">{{ _self.card_title('Trajets origine → destination les plus fréquents', 'origine-destination', query) }}</div>
      {% if routes is empty %}
        {{ ui.empty('Aucun trajet sur la période.') }}
      {% else %}
        <div class="overflow-x-auto">
          <table class="table">
            <thead class="bg-zinc-50"><tr><th>Départ</th><th>Arrivée</th><th class="text-right">Trajets</th><th class="text-right">Durée moy.</th></tr></thead>
            <tbody class="divide-y divide-zinc-100">
              {% for r in routes %}
                <tr>
                  <td>{{ r.station_depart }}</td>
                  <td>{{ r.station_arrivee }}{% if r.id_station_depart == r.id_station_arrivee %} <span class="text-xs text-zinc-400">(boucle)</span>{% endif %}</td>
                  <td class="text-right tabular-nums">{{ r.nb_trajets|num }}</td>
                  <td class="text-right tabular-nums">{{ r.duree_moyenne_min|round|duration }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    {# ---- Stations les plus / moins remplies #}
    <div class="card p-5">
      <h2 class="mb-3 font-semibold">Remplissage moyen par station</h2>
      <p class="mb-2 text-xs font-medium uppercase tracking-wide text-zinc-400">Souvent pleines</p>
      {% for s in busiest %}
        <div class="flex items-center justify-between py-1.5 text-sm"><span class="truncate pr-2">{{ s.nom }}</span>{{ ui.meter(s.taux) }}</div>
      {% else %}<p class="text-sm text-zinc-400">Aucun relevé.</p>{% endfor %}
      <p class="mb-2 mt-4 text-xs font-medium uppercase tracking-wide text-zinc-400">Souvent vides</p>
      {% for s in emptiest %}
        <div class="flex items-center justify-between py-1.5 text-sm"><span class="truncate pr-2">{{ s.nom }}</span>{{ ui.meter(s.taux) }}</div>
      {% endfor %}
    </div>
  </section>

  {# ---- Régulation (temps réel) #}
  <section class="mb-6 grid gap-6 lg:grid-cols-2">
    <div class="card overflow-hidden">
      <h2 class="px-5 pt-5 font-semibold">Stations à rééquilibrer <span class="text-xs font-normal text-zinc-400">maintenant · seuils 20 % / 80 %</span></h2>
      {% if rebalance is empty %}
        {{ ui.empty('Aucune station vide ou pleine actuellement.') }}
      {% else %}
        <div class="mt-3 max-h-80 overflow-auto">
          <table class="table">
            <thead class="bg-zinc-50"><tr><th>Station</th><th>Situation</th><th class="text-right">Vélos</th><th>Remplissage</th></tr></thead>
            <tbody class="divide-y divide-zinc-100">
              {% for s in rebalance %}
                <tr>
                  <td><a class="hover:text-emerald-700" href="{{ url_for('stations.show', {id: s.id_station}) }}">{{ s.nom }}</a></td>
                  <td>{{ ui.badge(s.situation) }}</td>
                  <td class="text-right tabular-nums">{{ s.nb_velos }} / {{ s.nb_bornes }}</td>
                  <td>{{ ui.meter(s.taux_remplissage) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
    <div class="card overflow-hidden">
      <h2 class="px-5 pt-5 font-semibold">Déplacements proposés</h2>
      {% if moves is empty %}
        {{ ui.empty('Aucun déplacement à proposer.') }}
      {% else %}
        <div class="mt-3 max-h-80 overflow-auto">
          <table class="table">
            <thead class="bg-zinc-50"><tr><th>De</th><th>Vers</th><th class="text-right">Vélos</th><th class="text-right">Distance</th></tr></thead>
            <tbody class="divide-y divide-zinc-100">
              {% for m in moves %}
                <tr>
                  <td>{{ m.station_depart }}</td><td>{{ m.station_arrivee }}</td>
                  <td class="text-right font-semibold tabular-nums">{{ m.nb_velos_a_deplacer }}</td>
                  <td class="text-right tabular-nums">{{ m.distance_km|num(2) }} km</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </section>

  <details class="text-xs text-zinc-500">
    <summary class="cursor-pointer">Temps d'exécution des requêtes ({{ timings|reduce((s, t) => s + t, 0)|num(1) }} ms au total)</summary>
    <ul class="mt-2 grid gap-1 sm:grid-cols-2">
      {% for proc, ms in timings %}<li><code>{{ proc }}</code> : {{ ms|num(1) }} ms</li>{% endfor %}
    </ul>
  </details>
{% endblock %}

{% macro card_title(title, rapport, query) %}
  <div class="mb-3 flex items-center justify-between gap-2">
    <h2 class="font-semibold">{{ title }}</h2>
    <a href="{{ url_for('stats.export', {rapport: rapport}, query) }}" class="text-xs text-zinc-500 hover:text-emerald-700" title="Exporter en CSV">CSV ↓</a>
  </div>
{% endmacro %}

{% block scripts %}
  <script type="application/json" id="charts-data">{{ charts|raw }}</script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script>
    (() => {
      if (typeof Chart === 'undefined') return;
      const data = JSON.parse(document.getElementById('charts-data').textContent);
      Chart.defaults.font.family = 'Inter, ui-sans-serif, system-ui, sans-serif';
      Chart.defaults.color = '#71717a';
      Chart.defaults.plugins.legend.display = false;
      Chart.defaults.maintainAspectRatio = false;
      const grid = { color: '#f4f4f5' };
      const hours = [...Array(24).keys()].map(h => h + ' h');

      new Chart(document.getElementById('chart-periods'), {
        type: 'line',
        data: { labels: data.periods.labels, datasets: [{ data: data.periods.values, borderColor: '#059669',
          backgroundColor: 'rgba(5,150,105,.08)', fill: true, tension: .3, pointRadius: 2 }] },
        options: { scales: { y: { beginAtZero: true, grid }, x: { grid: { display: false } } } }
      });
      new Chart(document.getElementById('chart-hours'), {
        type: 'bar',
        data: { labels: hours, datasets: [{ data: data.hours, backgroundColor: '#10b981', borderRadius: 4 }] },
        options: { scales: { y: { beginAtZero: true, grid }, x: { grid: { display: false } } } }
      });
      new Chart(document.getElementById('chart-occupancy'), {
        type: 'bar',
        data: { labels: hours, datasets: [{ data: data.occupancy, backgroundColor: '#0ea5e9', borderRadius: 4 }] },
        options: { scales: { y: { beginAtZero: true, max: 100, grid, ticks: { callback: v => v + ' %' } }, x: { grid: { display: false } } },
                   plugins: { tooltip: { callbacks: { label: c => c.parsed.y + ' %' } } } }
      });
    })();
  </script>
{% endblock %}
