{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% block title %}Locations{% endblock %}

{% block content %}
  {{ ui.page_header('Locations', 'Tous les trajets du réseau. Durée et coût sont calculés par la base à la restitution.') }}

  <form method="get" class="card mb-4 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-6">
    {{ ui.sort_fields(tri, 'locations') }}
    <input type="search" name="q" value="{{ filters.q }}" placeholder="Usager (nom ou email)…" class="input lg:col-span-2" aria-label="Usager">
    <select name="statut" class="input" aria-label="Statut">
      <option value="">Toutes</option>
      <option value="en_cours" {{ filters.statut == 'en_cours' ? 'selected' }}>En cours</option>
      <option value="terminees" {{ filters.statut == 'terminees' ? 'selected' }}>Terminées</option>
    </select>
    <select name="type" class="input" aria-label="Type de vélo">
      <option value="">Tous les vélos</option>
      <option value="mecanique" {{ filters.type == 'mecanique' ? 'selected' }}>Mécaniques</option>
      <option value="electrique" {{ filters.type == 'electrique' ? 'selected' }}>Électriques</option>
    </select>
    <select name="station" class="input lg:col-span-2" aria-label="Station de départ">
      <option value="">Toutes les stations de départ</option>
      {% for s in stations %}<option value="{{ s.id_station }}" {{ filters.station == s.id_station ? 'selected' }}>{{ s.nom }}</option>{% endfor %}
    </select>
    <label class="flex items-center gap-2 text-sm text-zinc-500">Du <input type="date" name="du" value="{{ filters.du }}" class="input"></label>
    <label class="flex items-center gap-2 text-sm text-zinc-500">au <input type="date" name="au" value="{{ filters.au }}" class="input"></label>
    <div class="flex gap-2 lg:col-span-4 lg:justify-end">
      <button class="btn-primary">Filtrer</button>
      <a href="{{ url_for('rentals.admin') }}" class="btn-ghost">Réinitialiser</a>
    </div>
  </form>
  {% if filters.statut == 'en_cours' %}
    <p class="mb-3 text-xs text-zinc-500">Les locations en cours sont affichées quelle que soit leur date.</p>
  {% endif %}

  <div class="card overflow-hidden" data-zone="locations">
    {% if rentals is empty %}
      {{ ui.empty('Aucune location ne correspond à ces critères.') }}
    {% else %}
      <div class="overflow-x-auto">
        <table class="table">
          <thead id="locations-head" class="bg-zinc-50">
            <tr>
              {{ ui.th('#', 'id', tri) }}{{ ui.th('Emprunt', 'emprunt', tri) }}{{ ui.th('Usager', 'usager', tri) }}
              {{ ui.th('Trajet', 'trajet', tri) }}{{ ui.th('Vélo', 'velo', tri) }}
              {{ ui.th('Durée', 'duree', tri, 'text-right') }}{{ ui.th('Coût', 'cout', tri, 'text-right') }}
            </tr>
          </thead>
          <tbody id="locations-body" class="divide-y divide-zinc-100">
            {% for l in rentals %}
              <tr>
                <td class="tabular-nums text-zinc-400">{{ l.id_location }}</td>
                <td>{{ l.date_heure_emprunt|dt }}</td>
                <td>{{ l.prenom }} {{ l.nom }}<p class="text-xs text-zinc-500">{{ l.email }}</p></td>
                <td>
                  {{ l.station_depart }} <span class="text-zinc-400">→</span>
                  {% if l.station_arrivee %}{{ l.station_arrivee }}{% else %}{{ ui.badge('en_location', 'En cours') }}{% endif %}
                </td>
                <td>#{{ l.id_velo }} <span class="text-xs text-zinc-500">{{ l.type_velo|label }}</span></td>
                <td class="text-right tabular-nums">{{ l.duree_min|duration }}</td>
                <td class="text-right tabular-nums">{{ l.cout|money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div id="locations-pager" data-zone-pager>{{ ui.pagination('rentals.admin', page, has_next, query) }}</div>
    {% endif %}
  </div>
{% endblock %}
