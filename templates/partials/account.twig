{% set user = current_user() %}
{% if user %}
  <details class="relative">
    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-zinc-100">
      <span class="grid size-7 place-items-center rounded-full bg-emerald-100 text-xs font-semibold text-emerald-700">
        {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
      </span>
      <span class="hidden text-sm font-medium sm:inline">{{ user.prenom }}</span>
    </summary>
    <div class="card absolute right-0 z-40 mt-2 w-60 p-2">
      <div class="px-3 py-2">
        <p class="truncate text-sm font-medium">{{ user.prenom }} {{ user.nom }}</p>
        <p class="truncate text-xs text-zinc-500">{{ user.email }}</p>
        <p class="mt-1 text-xs text-zinc-500">{{ user.role|label }}</p>
      </div>
      <a href="{{ url_for('profile') }}" class="block rounded-lg px-3 py-2 text-sm hover:bg-zinc-100">Mon profil</a>
      <form method="post" action="{{ url_for('logout') }}">
        {{ csrf_field() }}
        <button class="block w-full rounded-lg px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50">Se déconnecter</button>
      </form>
    </div>
  </details>
{% else %}
  <a href="{{ url_for('login') }}" class="btn-ghost">Connexion</a>
  <a href="{{ url_for('register') }}" class="btn-primary">S'inscrire</a>
{% endif %}
